<?xml version="1.0" encoding="utf-8"?>
<component name="WorkoutListScreen" extends="Group">
    <interface>
        <field id="token" type="string" onChange="loadWorkouts" />
        <field id="selectedWorkout" type="assocarray" alwaysNotify="true" />
        <field id="unauthorized" type="boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/api.brs" />
    <script type="text/brightscript" uri="pkg:/components/WorkoutListScreen.brs" />
    <children>
        <Label text="My Workouts" translation="[120,80]" color="0xFFFFFFFF">
            <Font role="font" uri="font:BoldSystemFontFile" size="72" />
        </Label>
        <Label text="OK to start  ·  * to refresh" translation="[120,180]" color="0x9CA3AFFF">
            <Font role="font" uri="font:SystemFontFile" size="34" />
        </Label>
        <LabelList id="list" translation="[120,280]" itemSize="[1680,100]" numRows="7" itemSpacing="[0,12]"
            color="0xD1D5DBFF" focusedColor="0x111827FF" focusBitmapBlendColor="0x4ADE80FF">
            <Font role="font" uri="font:SystemFontFile" size="44" />
            <Font role="focusedFont" uri="font:BoldSystemFontFile" size="44" />
        </LabelList>
        <Label id="message" translation="[120,300]" width="1680" wrap="true" color="0x9CA3AFFF">
            <Font role="font" uri="font:SystemFontFile" size="44" />
        </Label>
    </children>
</component>
